NODE_ENV=development
PORT=3000

# Database — use either Postgres (recommended on Railway) or SQLite (self-contained)
# For SQLite leave DATABASE_URL empty or set:
# DATABASE_URL=sqlite:./data/ghost.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/ghost

SESSION_SECRET=replace-with-at-least-32-random-characters-here
ADMIN_USERNAME=owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMeToSomethingLong14chars

# Optional Railway integration
RAILWAY_API_TOKEN=
RAILWAY_GRAPHQL_URL=https://backboard.railway.com/graphql/v2

APP_NAME=Gost Hosting
PROJECT_FILES_ROOT=./project-files
MAX_UPLOAD_MB=50
